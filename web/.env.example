# Same settings as the old Express API's .env
PORT=3000
DB_RUN=false
# Shared teams + matches: mysql on the server, JSON files in DATA_DIR otherwise
STORAGE=json
DATA_DIR=./data
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=cricscore
# Legacy MySQL routes (only when DB_RUN=true)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Overlay / streaming links
PUBLIC_URL=
LIVE_STREAM_URL=http://localhost:3300
LIVE_STREAM_SECRET=
STREAM_MAX_VIEWERS=8
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
# Camera-phone recordings (/go page). Default folder: DATA_DIR/recordings (or data/recordings).
# ffmpeg (optional) fixes the video header after recording so players can seek in it.
RECORDINGS_DIR=
FFMPEG_PATH=
# "Save to YouTube": Google Cloud → YouTube Data API v3 → OAuth client "TVs and Limited Input devices"
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
