DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=live_stream

NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_STUN_SERVER=stun:stun.l.google.com:19302

TURN_SERVER=
TURN_USERNAME=
TURN_PASSWORD=

# At least 32 random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# Optional
PORT=3000
# How long a LIVE room survives a broadcaster disconnect before it is ended (ms)
BROADCASTER_RECONNECT_GRACE_MS=60000
# Serve over HTTPS (needed for camera access from other devices on your network)
HTTPS_KEY_FILE=
HTTPS_CERT_FILE=

# Serve under a sub-path, e.g. /stream behind the CricScore server (build-time)
NEXT_PUBLIC_BASE_PATH=

# CricScore integration: shared secret (32+ chars) and the CricScore API for the live score overlay
INTEGRATION_SECRET=
CRICSCORE_API_URL=http://localhost:3000/api

# Where recordings are stored
RECORDINGS_DIR=./recordings

# YouTube upload: Google Cloud OAuth client of type "TVs and Limited Input devices", YouTube Data API v3 enabled
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
